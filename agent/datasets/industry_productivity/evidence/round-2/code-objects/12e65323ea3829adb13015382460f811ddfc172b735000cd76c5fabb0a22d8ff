#!/usr/bin/env python3
"""Build Productivity_Summary on top of the original BLS workbook (v1)."""
import json
import shutil
from copy import copy
from pathlib import Path

from openpyxl import load_workbook
from openpyxl.chart import BarChart, LineChart, Reference
from openpyxl.chart.label import DataLabelList
from openpyxl.chart.marker import Marker
from openpyxl.chart.series import SeriesLabel
from openpyxl.comments import Comment
from openpyxl.formatting.rule import ColorScaleRule, DataBarRule, FormulaRule
from openpyxl.styles import Alignment, Border, Font, PatternFill, Side
from openpyxl.worksheet.datavalidation import DataValidation

ROOT = Path(__file__).resolve().parent
SRC = ROOT / "input" / "labor-productivity-detailed-industries.xlsx"
OUT = ROOT / "output" / "industry_productivity_enhanced.xlsx"

NAVY = "FF1F3864"
BLUE = "FF2F5597"
LIGHT = "FFD9E2F3"
PALE = "FFF2F5FA"
GREY = "FF7F7F7F"
BORDER = "FFBFBFBF"
INPUT_BLUE = "FF0000FF"
LINK_GREEN = "FF008000"
BLACK = "FF000000"

thin = Side(style="thin", color=BORDER)
box = Border(left=thin, right=thin, top=thin, bottom=thin)
ARI = "Arial"

wb = load_workbook(SRC)
ws = wb.create_sheet("Productivity_Summary", 0)

ws.sheet_view.showGridLines = False
ws.sheet_properties.tabColor = "1F3864"

widths = {"A": 38, "B": 18, "C": 24, "D": 24, "E": 22, "F": 18}
for col, w in widths.items():
    ws.column_dimensions[col].width = w


def put(ref, value, *, bold=False, size=11, color=BLACK, fill=None,
        italic=False, align="left", fmt=None, wrap=False, border=False):
    c = ws[ref]
    c.value = value
    c.font = Font(name=ARI, bold=bold, size=size, color=color, italic=italic)
    if fill:
        c.fill = PatternFill(fill_type="solid", start_color=fill, end_color=fill)
    c.alignment = Alignment(horizontal=align, vertical="center", wrap_text=wrap)
    if fmt:
        c.number_format = fmt
    if border:
        c.border = box
    return c


def band(row, text):
    ws.merge_cells(start_row=row, start_column=1, end_row=row, end_column=6)
    put(f"A{row}", text, bold=True, size=10, color="FFFFFFFF", fill=NAVY)
    ws.row_dimensions[row].height = 20


# ---------------------------------------------------------------- header
ws.merge_cells("A1:F1")
put("A1", "Industry Productivity Dashboard — Food Manufacturing (NAICS 311)",
    bold=True, size=16, color="FFFFFFFF", fill=NAVY)
ws.row_dimensions[1].height = 30

ws.merge_cells("A2:F2")
put("A2", "Bureau of Labor Statistics · Annual labor productivity and costs, detailed industries · "
          "Index (2017 = 100), 2025 published values",
    size=9, italic=True, color=GREY, fill=LIGHT)
ws.row_dimensions[2].height = 18

band(4, "2025 KEY PERFORMANCE INDICATORS — FOOD MANUFACTURING, ALL WORKERS")

rows = [
    (5, "Hours worked, 2025", "=Annual!AT489", "Index (2017 = 100)", "0.000"),
    (6, "Real sectoral output, 2025", "=Annual!AT488", "Index (2017 = 100)", "0.000"),
    (7, "Labor productivity, 2025", "=Annual!AT487", "Index (2017 = 100)", "0.000"),
    (8, "Output per worker, 2025", "=Annual!AT490", "Index (2017 = 100)", "0.000"),
]
for r, label, formula, unit, fmt in rows:
    put(f"A{r}", label, bold=False, color=BLACK, border=True)
    put(f"B{r}", formula, color=LINK_GREEN, align="right", fmt=fmt, border=True)
    put(f"C{r}", unit, size=9, color=GREY, border=True)
    ws.row_dimensions[r].height = 18

put("A9", "Source consistency status", bold=True, color=BLACK, border=True)
put("B9",
    '=IF(AND(Annual!AT489>0,Annual!AT490>0,'
    'ABS(Annual!AT488/Annual!AT489*100-Annual!AT487)<0.01),"PASS","REVIEW")',
    bold=True, color=LINK_GREEN, align="center", border=True)
put("C9", "PASS = published series reconcile", size=9, color=GREY, border=True)
ws.row_dimensions[9].height = 18

# ---------------------------------------------------------------- scenario
band(11, "SCENARIO SENSITIVITY — ILLUSTRATIVE, NOT A FORECAST")

put("A12", "Scenario", bold=True, color=BLACK)
put("B12", "Base", bold=True, color=INPUT_BLUE, fill="FFFFF2CC", align="center", border=True)
ws.row_dimensions[12].height = 20

dv = DataValidation(type="list", formula1='"Base,Upside,Downside"', allow_blank=False,
                    showDropDown=False, showErrorMessage=True,
                    errorTitle="Invalid scenario", error="Select Base, Upside or Downside.",
                    promptTitle="Scenario", prompt="Choose Base, Upside or Downside.")
ws.add_data_validation(dv)
dv.add(ws["B12"])

put("D12", "Scenario", bold=True, size=10, color="FFFFFFFF", fill=BLUE, align="center", border=True)
put("E12", "Productivity multiplier", bold=True, size=10, color="FFFFFFFF", fill=BLUE, align="center", wrap=True, border=True)
put("F12", "Hours multiplier", bold=True, size=10, color="FFFFFFFF", fill=BLUE, align="center", wrap=True, border=True)
ws.row_dimensions[12].height = 30

scenario_table = [
    ("Base", 1.00, 1.00),
    ("Upside", 1.08, 1.05),
    ("Downside", 0.93, 0.95),
]
for i, (name, prod, hrs) in enumerate(scenario_table):
    r = 13 + i
    put(f"D{r}", name, color=INPUT_BLUE, fill="FFFFF2CC", border=True)
    put(f"E{r}", prod, color=INPUT_BLUE, fill="FFFFF2CC", align="right", fmt='0.00"x"', border=True)
    put(f"F{r}", hrs, color=INPUT_BLUE, fill="FFFFF2CC", align="right", fmt='0.00"x"', border=True)

put("A13", "Selected productivity multiplier", color=BLACK, border=True)
put("B13", '=IF($B$12=$D$13,$E$13,IF($B$12=$D$14,$E$14,$E$15))',
    color=BLACK, align="right", fmt='0.00"x"', border=True)
put("A14", "Selected hours multiplier", color=BLACK, border=True)
put("B14", '=IF($B$12=$D$13,$F$13,IF($B$12=$D$14,$F$14,$F$15))',
    color=BLACK, align="right", fmt='0.00"x"', border=True)
put("A15", "Projected hours-worked index", color=BLACK, border=True)
put("B15", "=B5*B14", color=BLACK, align="right", fmt="0.000", border=True)
put("A16", "Projected real-output index", color=BLACK, border=True)
put("B16", "=B6*B13*B14", color=BLACK, align="right", fmt="0.000", border=True)
for r in (13, 14, 15, 16):
    ws.row_dimensions[r].height = 18

ws.merge_cells("A17:F17")
put("A17", "Multipliers are illustrative sensitivities applied to the 2025 published index, not forecasts. "
           "Projected hours = 2025 hours × hours multiplier; projected real output = 2025 real output × "
           "productivity multiplier × hours multiplier.",
    size=9, italic=True, color=GREY, wrap=True)
ws.row_dimensions[17].height = 28

# ---------------------------------------------------------------- chart data
put("A19", "Subindustry", bold=True, size=10, color=BLACK, fill=LIGHT, border=True)
put("B19", "2025 productivity index", bold=True, size=10, color=BLACK, fill=LIGHT,
    align="center", wrap=True, border=True)
put("D19", "Year", bold=True, size=10, color=BLACK, fill=LIGHT, align="center", border=True)
put("E19", "Food productivity index", bold=True, size=10, color=BLACK, fill=LIGHT,
    align="center", wrap=True, border=True)
ws.row_dimensions[19].height = 30

subs = [
    ("Food", "=Annual!AT487"),
    ("Beverages and tobacco", "=Annual!AT510"),
    ("Textile mills", "=Annual!AT533"),
    ("Textile products", "=Annual!AT556"),
    ("Apparel", "=Annual!AT579"),
]
for i, (label, formula) in enumerate(subs):
    r = 20 + i
    put(f"A{r}", label, color=INPUT_BLUE, border=True)
    put(f"B{r}", formula, color=LINK_GREEN, align="right", fmt="0.000", border=True)
    ws.row_dimensions[r].height = 18

trend = [
    ("2021", "=Annual!AP487"),
    ("2022", "=Annual!AQ487"),
    ("2023", "=Annual!AR487"),
    ("2024", "=Annual!AS487"),
    ("2025", "=Annual!AT487"),
]
for i, (label, formula) in enumerate(trend):
    r = 20 + i
    put(f"D{r}", label, color=INPUT_BLUE, fmt="@", align="center", border=True)
    put(f"E{r}", formula, color=LINK_GREEN, align="right", fmt="0.000", border=True)

# ---------------------------------------------------------------- charts
bar = BarChart()
bar.type = "col"
bar.style = 10
bar.title = "2025 Labor Productivity by Manufacturing Subindustry"
bar.y_axis.title = "Index (2017 = 100)"
bar.x_axis.title = "NAICS 311–315"
bar.y_axis.majorGridlines = None
bar.legend = None
bar.gapWidth = 60
data = Reference(ws, min_col=2, min_row=20, max_row=24)
cats = Reference(ws, min_col=1, min_row=20, max_row=24)
bar.add_data(data, titles_from_data=False)
bar.set_categories(cats)
bar.series[0].tx = SeriesLabel(v="2025 labor productivity index")
bar.series[0].graphicalProperties.solidFill = "2F5597"
bar.series[0].graphicalProperties.line.solidFill = "1F3864"
bar.dLbls = DataLabelList()
bar.dLbls.showVal = True
bar.height = 8.8
bar.width = 15.5
ws.add_chart(bar, "A27")

line = LineChart()
line.style = 12
line.title = "Food Manufacturing Labor Productivity, 2021–2025"
line.y_axis.title = "Index (2017 = 100)"
line.x_axis.title = "Year"
line.legend = None
ldata = Reference(ws, min_col=5, min_row=20, max_row=24)
lcats = Reference(ws, min_col=4, min_row=20, max_row=24)
line.add_data(ldata, titles_from_data=False)
line.set_categories(lcats)
line.series[0].tx = SeriesLabel(v="Food manufacturing labor productivity")
line.series[0].graphicalProperties.line.solidFill = "1F3864"
line.series[0].graphicalProperties.line.width = 28000
line.series[0].marker = Marker(symbol="circle", size=7)
line.series[0].smooth = False
line.height = 8.8
line.width = 15.5
ws.add_chart(line, "H27")

# ---------------------------------------------------------------- conditional formats
ws.conditional_formatting.add(
    "B5:B8",
    ColorScaleRule(start_type="min", start_color="FFF8696B",
                   mid_type="percentile", mid_value=50, mid_color="FFFFEB84",
                   end_type="max", end_color="FF63BE7B"),
)
ws.conditional_formatting.add(
    "B9",
    FormulaRule(formula=['$B$9="PASS"'],
                fill=PatternFill(fill_type="solid", start_color="FFC6EFCE", end_color="FFC6EFCE"),
                font=Font(name=ARI, bold=True, color="FF006100")),
)
ws.conditional_formatting.add(
    "B9",
    FormulaRule(formula=['$B$9="REVIEW"'],
                fill=PatternFill(fill_type="solid", start_color="FFFFC7CE", end_color="FFFFC7CE"),
                font=Font(name=ARI, bold=True, color="FF9C0006")),
)
ws.conditional_formatting.add(
    "B15:B16",
    DataBarRule(start_type="num", start_value=80, end_type="num", end_value=130,
                color="FF5B9BD5", showValue=True),
)

# ---------------------------------------------------------------- comments
ws["B9"].comment = Comment(
    "Reconciliation: PASS only when Annual!AT489 (hours) and Annual!AT490 (output per worker) are "
    "positive and ABS(AT488/AT489*100-AT487) < 0.01, i.e. real output / hours reproduces the "
    "published labor-productivity index within three-decimal rounding.",
    "Analyst", width=360, height=120)
ws["B12"].comment = Comment(
    "Scenario selector drives B13:B16. Base 1.00x/1.00x, Upside 1.08x productivity and 1.05x hours, "
    "Downside 0.93x/0.95x. Illustrative sensitivities only; not BLS projections or forecasts.",
    "Analyst", width=330, height=110)
ws["B7"].comment = Comment(
    "Source: BLS Annual labor productivity and costs, detailed industries (released 2026-09-24), "
    "Food manufacturing NAICS 311, All workers, Labor productivity index (2017=100), 2025 = Annual!AT487. "
    "Annual and MachineReadable are overlapping views of the same published series, not independent observations.",
    "Analyst", width=380, height=130)

# ---------------------------------------------------------------- misc layout
ws.freeze_panes = "A5"
ws.sheet_view.zoomScale = 100
ws.print_options.horizontalCentered = True
ws.page_setup.orientation = "landscape"
ws.page_setup.fitToWidth = 1
ws.sheet_properties.pageSetUpPr.fitToPage = True

ws.merge_cells("A45:F45")
put("A45", "Source: U.S. Bureau of Labor Statistics, Annual labor productivity and costs: detailed "
           "industries (data released September 24, 2026). Index values are not physical hours or output levels.",
    size=8, italic=True, color=GREY, wrap=True)

# force Arial everywhere on the new sheet
for row in ws.iter_rows(min_row=1, max_row=45, min_col=1, max_col=6):
    for cell in row:
        if cell.value is not None:
            f = copy(cell.font)
            f.name = ARI
            cell.font = f

wb.active = 0
wb.save(OUT)

# ---------------------------------------------------------------- stats
stats = {
    "sheets": wb.sheetnames,
    "formula_cells": [f"{c.coordinate}" for row in ws.iter_rows(min_row=1, max_row=24, max_col=6)
                      for c in row if c.data_type == "f"],
    "chart_count": len(ws._charts),
    "conditional_format_ranges": sorted({str(a) for g in ws.conditional_formatting
                                         for a in g.sqref.ranges}),
    "comments": [c.coordinate for row in ws.iter_rows() for c in row if c.comment],
    "freeze_panes": ws.freeze_panes,
    "output_bytes": OUT.stat().st_size,
}
print(json.dumps(stats, indent=2))
