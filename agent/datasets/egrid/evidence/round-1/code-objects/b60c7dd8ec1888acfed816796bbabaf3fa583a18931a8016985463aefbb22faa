#!/usr/bin/env python3
"""Build Energy_Summary on top of the original eGRID2023 Rev 2 workbook."""
import shutil
from pathlib import Path

from openpyxl import load_workbook
from openpyxl.chart import BarChart, PieChart, Reference
from openpyxl.chart.label import DataLabelList
from openpyxl.comments import Comment
from openpyxl.formatting.rule import CellIsRule, ColorScaleRule, DataBarRule
from openpyxl.styles import Alignment, Border, Font, PatternFill, Side
from openpyxl.worksheet.datavalidation import DataValidation

ROOT = Path(__file__).resolve().parent
SRC = ROOT / "input" / "egrid2023_data_rev2.xlsx"
DST = ROOT / "output" / "energy_report.xlsx"

NAVY = "1F3864"
BLUE = "2F5597"
PALE = "D9E2F3"
GREY = "F2F2F2"
MIDGREY = "808080"
BORDER = "BFBFBF"

FONT = "Arial"
BLUE_FONT = Font(name=FONT, size=10, color="0000FF")
GREEN_FONT = Font(name=FONT, size=10, color="008000")
BLACK_FONT = Font(name=FONT, size=10, color="000000")
LABEL_FONT = Font(name=FONT, size=10, color="262626")

thin = Side(style="thin", color=BORDER)
BOX = Border(left=thin, right=thin, top=thin, bottom=thin)


def fill(color):
    return PatternFill(start_color=color, end_color=color, fill_type="solid")


def section(ws, row, text, last_col="F"):
    ws.merge_cells(f"A{row}:{last_col}{row}")
    cell = ws[f"A{row}"]
    cell.value = text
    cell.font = Font(name=FONT, size=10, bold=True, color="FFFFFF")
    cell.fill = fill(NAVY)
    cell.alignment = Alignment(horizontal="left", vertical="center", indent=1)
    ws.row_dimensions[row].height = 20


shutil.copyfile(SRC, DST)
wb = load_workbook(DST)
ws = wb.create_sheet("Energy_Summary", 0)

# ------------------------------------------------------------------ title
ws.merge_cells("A1:F1")
t = ws["A1"]
t.value = "U.S. Electricity & Emissions — Executive Summary"
t.font = Font(name=FONT, size=16, bold=True, color="FFFFFF")
t.fill = fill(NAVY)
t.alignment = Alignment(horizontal="left", vertical="center", indent=1)
ws.row_dimensions[1].height = 30

ws.merge_cells("A2:F2")
s = ws["A2"]
s.value = ("EPA eGRID2023 Revision 2  |  Data year 2023  |  U.S. totals from US23 row 3; "
           "state detail from ST23")
s.font = Font(name=FONT, size=9, italic=True, color="595959")
s.fill = fill(GREY)
s.alignment = Alignment(horizontal="left", vertical="center", indent=1)
ws.row_dimensions[2].height = 18

# ------------------------------------------------------------------ KPIs
section(ws, 4, "KEY PERFORMANCE INDICATORS  —  U.S. TOTAL, 2023")

kpis = [
    (5, "Annual net generation (MWh)", "=US23!G3", "#,##0", "Source: US23!G3 — U.S. annual net generation, published total."),
    (6, "Annual CO2 emissions (short tons)", "=US23!M3", "#,##0", "Source: US23!M3 — U.S. annual CO2 emissions, published total."),
    (7, "CO2 total output emission rate (lb/MWh)", "=US23!U3", "#,##0.0", "Source: US23!U3 — U.S. annual CO2 total output emission rate."),
    (8, "Gas generation share (fraction)", "=US23!DZ3", "0.0%", "Source: US23!DZ3 — U.S. gas share of generation (resource mix); stored as a fraction."),
]
for row, label, formula, numfmt, note in kpis:
    ws[f"A{row}"] = label
    ws[f"A{row}"].font = LABEL_FONT
    ws[f"A{row}"].alignment = Alignment(vertical="center", indent=1)
    c = ws[f"B{row}"]
    c.value = formula
    c.font = GREEN_FONT
    c.number_format = numfmt
    c.alignment = Alignment(horizontal="right", vertical="center")
    c.comment = Comment(note, "Analyst", width=320, height=90)
    ws[f"C{row}"] = note.split("—")[1].strip() if "—" in note else ""
    ws[f"C{row}"].font = Font(name=FONT, size=8, italic=True, color=MIDGREY)
    ws[f"C{row}"].alignment = Alignment(vertical="center", indent=1)
    for col in "ABC":
        ws[f"{col}{row}"].border = BOX
    ws.row_dimensions[row].height = 19

ws["A9"] = "Source consistency status"
ws["A9"].font = LABEL_FONT
ws["A9"].alignment = Alignment(vertical="center", indent=1)
ws["B9"] = ('=IF(AND(US23!G3>0,US23!M3>=0,US23!U3>=0,US23!DZ3>=0,US23!DZ3<=1,'
            'ABS(US23!U3-US23!M3*2000/US23!G3)<0.01),"PASS","REVIEW")')
ws["B9"].font = GREEN_FONT
ws["B9"].alignment = Alignment(horizontal="center", vertical="center")
ws["B9"].number_format = "General"
ws["B9"].comment = Comment(
    "PASS only when US23!G3 > 0, US23!M3 and US23!U3 are nonnegative, US23!DZ3 is between 0 and 1, "
    "and the published rate reconciles to emissions x 2,000 / generation within 0.01 lb/MWh.",
    "Analyst", width=340, height=110)
ws["C9"] = "Reconciles U3 against M3 x 2,000 / G3 (tolerance 0.01 lb/MWh)."
ws["C9"].font = Font(name=FONT, size=8, italic=True, color=MIDGREY)
ws["C9"].alignment = Alignment(vertical="center", indent=1)
for col in "ABC":
    ws[f"{col}9"].border = BOX
ws.row_dimensions[9].height = 19

# ------------------------------------------------------------------ scenario
section(ws, 11, "SCENARIO ANALYSIS  —  ILLUSTRATIVE SENSITIVITIES (NOT FORECASTS)")

ws["A12"] = "Scenario selector"
ws["A12"].font = Font(name=FONT, size=10, bold=True, color="262626")
ws["A12"].alignment = Alignment(vertical="center", indent=1)
ws["B12"] = "Base"
ws["B12"].font = Font(name=FONT, size=10, bold=True, color="0000FF")
ws["B12"].fill = fill("FFF2CC")
ws["B12"].alignment = Alignment(horizontal="center", vertical="center")
ws["B12"].border = BOX
ws["B12"].comment = Comment(
    "Editable input. Dropdown: Base / Upside / Downside. Drives B13:B14 through the D13:F15 table.",
    "Analyst", width=300, height=90)
ws["C12"] = "Blue = input; select Base/Upside/Downside."
ws["C12"].font = Font(name=FONT, size=8, italic=True, color=MIDGREY)
ws["C12"].alignment = Alignment(vertical="center", indent=1)

dv = DataValidation(type="list", formula1='"Base,Upside,Downside"', allow_blank=False,
                    showErrorMessage=True, errorTitle="Invalid scenario",
                    error="Select Base, Upside or Downside.",
                    promptTitle="Scenario", prompt="Select an illustrative scenario.")
ws.add_data_validation(dv)
dv.add(ws["B12"])

# scenario table header
for ref, text in (("D12", "Scenario"), ("E12", "Emission intensity multiplier"),
                  ("F12", "Generation multiplier")):
    c = ws[ref]
    c.value = text
    c.font = Font(name=FONT, size=9, bold=True, color="FFFFFF")
    c.fill = fill(BLUE)
    c.alignment = Alignment(horizontal="center", vertical="center", wrap_text=True)
    c.border = BOX
ws.row_dimensions[12].height = 30

table = [("Base", 1.00, 1.00), ("Upside", 1.08, 1.05), ("Downside", 0.93, 0.95)]
for i, (name, ei, gen) in enumerate(table):
    r = 13 + i
    ws[f"D{r}"] = name
    ws[f"D{r}"].font = Font(name=FONT, size=10, bold=True, color="262626")
    ws[f"D{r}"].alignment = Alignment(horizontal="left", vertical="center", indent=1)
    ws[f"E{r}"] = ei
    ws[f"F{r}"] = gen
    for col in ("E", "F"):
        ws[f"{col}{r}"].font = BLUE_FONT
        ws[f"{col}{r}"].number_format = "0.00"
        ws[f"{col}{r}"].alignment = Alignment(horizontal="center", vertical="center")
    for col in "DEF":
        ws[f"{col}{r}"].border = BOX
        if i % 2 == 1:
            ws[f"{col}{r}"].fill = fill(GREY)

rows = [
    (13, "Selected emission intensity multiplier", "=VLOOKUP($B$12,$D$13:$F$15,2,FALSE)", "0.00\"x\""),
    (14, "Selected generation multiplier", "=VLOOKUP($B$12,$D$13:$F$15,3,FALSE)", "0.00\"x\""),
    (15, "Projected annual net generation (MWh)", "=B5*B14", "#,##0"),
    (16, "Projected annual CO2 emissions (short tons)", "=B6*B13*B14", "#,##0"),
]
for row, label, formula, numfmt in rows:
    ws[f"A{row}"] = label
    ws[f"A{row}"].font = Font(name=FONT, size=10, bold=(row >= 15), color="262626")
    ws[f"A{row}"].alignment = Alignment(vertical="center", indent=1)
    c = ws[f"B{row}"]
    c.value = formula
    c.font = BLACK_FONT
    c.number_format = numfmt
    c.alignment = Alignment(horizontal="right", vertical="center")
    for col in "ABC":
        ws[f"{col}{row}"].border = BOX
    ws.row_dimensions[row].height = 19

ws["B16"].comment = Comment(
    "Projected CO2 = published CO2 (B6) x emission intensity multiplier (B13) x generation multiplier (B14). "
    "Multipliers are illustrative sensitivities, not forecasts.",
    "Analyst", width=340, height=100)
ws["C15"] = "Base generation x B14."
ws["C16"] = "Base CO2 x B13 x B14."
for ref in ("C15", "C16"):
    ws[ref].font = Font(name=FONT, size=8, italic=True, color=MIDGREY)
    ws[ref].alignment = Alignment(vertical="center", indent=1)

ws.merge_cells("A17:F17")
ws["A17"] = ("Illustrative sensitivities only. Scenario names denote higher/lower assumptions and are not "
             "forecasts, guidance or EPA projections.")
ws["A17"].font = Font(name=FONT, size=8, italic=True, color=MIDGREY)
ws["A17"].alignment = Alignment(horizontal="left", vertical="center", indent=1)

# ------------------------------------------------------------------ chart tables
ws["A19"] = "State"
ws["B19"] = "Annual net generation (MWh)"
ws["D19"] = "Resource"
ws["E19"] = "U.S. generation share"
for ref in ("A19", "B19", "D19", "E19"):
    c = ws[ref]
    c.font = Font(name=FONT, size=9, bold=True, color="FFFFFF")
    c.fill = fill(BLUE)
    c.alignment = Alignment(horizontal="center", vertical="center", wrap_text=True)
    c.border = BOX
ws.row_dimensions[19].height = 28

states = [("CA", "=ST23!I7"), ("NY", "=ST23!I37"), ("TX", "=ST23!I47"),
          ("FL", "=ST23!I12"), ("PA", "=ST23!I41")]
for i, (name, formula) in enumerate(states):
    r = 20 + i
    ws[f"A{r}"] = name
    ws[f"A{r}"].font = Font(name=FONT, size=10, bold=True, color="262626")
    ws[f"A{r}"].alignment = Alignment(horizontal="center", vertical="center")
    c = ws[f"B{r}"]
    c.value = formula
    c.font = GREEN_FONT
    c.number_format = "#,##0"
    c.alignment = Alignment(horizontal="right", vertical="center")
    for col in "AB":
        ws[f"{col}{r}"].border = BOX

resources = [("Coal", "=US23!DX3"), ("Gas", "=US23!DZ3"), ("Nuclear", "=US23!EA3"),
             ("Hydro", "=US23!EB3"), ("Wind", "=US23!ED3"), ("Solar", "=US23!EE3")]
for i, (name, formula) in enumerate(resources):
    r = 20 + i
    ws[f"D{r}"] = name
    ws[f"D{r}"].font = Font(name=FONT, size=10, color="262626")
    ws[f"D{r}"].alignment = Alignment(horizontal="left", vertical="center", indent=1)
    c = ws[f"E{r}"]
    c.value = formula
    c.font = GREEN_FONT
    c.number_format = "0.0%"
    c.alignment = Alignment(horizontal="right", vertical="center")
    for col in "DE":
        ws[f"{col}{r}"].border = BOX

# ------------------------------------------------------------------ charts
bar = BarChart()
bar.type = "col"
bar.style = 10
bar.title = "Annual Net Generation — CA, NY, TX, FL, PA (MWh)"
bar.y_axis.title = "MWh"
bar.x_axis.title = "State"
data = Reference(ws, min_col=2, min_row=19, max_row=24)
cats = Reference(ws, min_col=1, min_row=20, max_row=24)
bar.add_data(data, titles_from_data=True)
bar.set_categories(cats)
bar.legend = None
bar.gapWidth = 60
bar.height = 8.6
bar.width = 15.5
bar.y_axis.numFmt = "#,##0"
bar.y_axis.majorGridlines = None
ws.add_chart(bar, "H4")

pie = PieChart()
pie.title = "U.S. Generation Resource Mix (share of generation)"
pdata = Reference(ws, min_col=5, min_row=19, max_row=25)
pcats = Reference(ws, min_col=4, min_row=20, max_row=25)
pie.add_data(pdata, titles_from_data=True)
pie.set_categories(pcats)
pie.height = 8.6
pie.width = 13.0
pie.dLbls = DataLabelList()
pie.dLbls.showVal = True
pie.dLbls.showCatName = False
pie.dLbls.showSerName = False
pie.dLbls.showPercent = False
pie.dLbls.numFmt = "0.0%"
pie.dLbls.position = "bestFit"
pie.legend.position = "r"
ws.add_chart(pie, "H22")

# ------------------------------------------------------------------ formatting extras
ws.column_dimensions["A"].width = 38
ws.column_dimensions["B"].width = 20
ws.column_dimensions["C"].width = 44
ws.column_dimensions["D"].width = 13
ws.column_dimensions["E"].width = 18
ws.column_dimensions["F"].width = 16

ws.freeze_panes = "A5"
ws.sheet_view.showGridLines = False
ws.sheet_view.zoomScale = 90
ws.sheet_properties.tabColor = NAVY

ws.conditional_formatting.add(
    "B9",
    CellIsRule(operator="equal", formula=['"PASS"'], fill=fill("C6EFCE"),
               font=Font(name=FONT, size=10, bold=True, color="006100")))
ws.conditional_formatting.add(
    "B9",
    CellIsRule(operator="equal", formula=['"REVIEW"'], fill=fill("FFC7CE"),
               font=Font(name=FONT, size=10, bold=True, color="9C0006")))
ws.conditional_formatting.add(
    "B20:B24",
    DataBarRule(start_type="num", start_value=0, end_type="max", color="2F5597", showValue=True))
ws.conditional_formatting.add(
    "E20:E25",
    ColorScaleRule(start_type="min", start_color="FFFFFF", end_type="max", end_color="2F5597"))

wb.calculation.fullCalcOnLoad = True
wb.active = 0
wb.save(DST)
print("saved", DST, DST.stat().st_size)
