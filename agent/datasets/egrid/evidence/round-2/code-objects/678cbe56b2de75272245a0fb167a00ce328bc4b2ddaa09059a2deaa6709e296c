#!/usr/bin/env python3
"""Build output/energy_report.xlsx: preserve the eGRID2023 workbook and add Energy_Summary."""
import shutil
from pathlib import Path

from openpyxl import load_workbook
from openpyxl.chart import BarChart, PieChart, Reference
from openpyxl.comments import Comment
from openpyxl.formatting.rule import CellIsRule, ColorScaleRule, FormulaRule
from openpyxl.styles import Alignment, Border, Font, PatternFill, Side
from openpyxl.worksheet.datavalidation import DataValidation

ROOT = Path(__file__).resolve().parents[1]
SRC = ROOT / "input" / "egrid2023_data_rev2.xlsx"
DST = ROOT / "output" / "energy_report.xlsx"

NAVY = "FF1F3864"
BLUE = "FF2F5597"
LIGHT = "FFD9E2F3"
PALE = "FFF2F5FA"
GRAY = "FFF2F2F2"
MIDGRAY = "FF808080"
WHITE = "FFFFFFFF"
BLUE_FONT = "FF0000FF"
GREEN_FONT = "FF008000"
BLACK_FONT = "FF000000"

ARIAL = "Arial"


def font(size=10, bold=False, color=BLACK_FONT, italic=False):
    return Font(name=ARIAL, size=size, bold=bold, color=color, italic=italic)


def fill(rgb):
    return PatternFill(fill_type="solid", start_color=rgb, end_color=rgb)


def section(ws, ref, text):
    ws.merge_cells(ref)
    first = ref.split(":")[0]
    cell = ws[first]
    cell.value = text
    cell.font = font(11, bold=True, color=WHITE)
    cell.fill = fill(BLUE)
    cell.alignment = Alignment(horizontal="left", vertical="center", indent=1)
    row = cell.row
    ws.row_dimensions[row].height = 22


def main():
    DST.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(SRC, DST)
    wb = load_workbook(DST)
    ws = wb.create_sheet("Energy_Summary", 0)
    ws.sheet_properties.tabColor = NAVY
    ws.sheet_view.showGridLines = False
    ws.freeze_panes = "A5"

    widths = {"A": 38, "B": 26, "C": 22, "D": 24, "E": 22, "F": 22, "G": 3}
    for col, width in widths.items():
        ws.column_dimensions[col].width = width

    # Title block
    ws.merge_cells("A1:F1")
    ws["A1"] = "U.S. Electricity & Emissions — Executive Summary"
    ws["A1"].font = font(16, bold=True, color=WHITE)
    ws["A1"].fill = fill(NAVY)
    ws["A1"].alignment = Alignment(horizontal="left", vertical="center", indent=1)
    ws.row_dimensions[1].height = 34

    ws.merge_cells("A2:F2")
    ws["A2"] = ("Source: U.S. EPA eGRID2023 Revision 2 (published June 12, 2025) — "
                "U.S. totals and published generation shares")
    ws["A2"].font = font(9, italic=True, color="FF595959")
    ws["A2"].fill = fill(GRAY)
    ws["A2"].alignment = Alignment(horizontal="left", vertical="center", indent=1)
    ws.row_dimensions[2].height = 18

    # KPI block
    section(ws, "A4:C4", "Key performance indicators (published U.S. totals)")

    kpis = [
        (5, "Annual net generation", "MWh", "=US23!G3", "#,##0"),
        (6, "Annual CO2 emissions", "short tons", "=US23!M3", "#,##0"),
        (7, "CO2 total output emission rate", "lb/MWh", "=US23!U3", "#,##0.000"),
        (8, "Gas generation share", "share of net generation", "=US23!DZ3", "0.0%"),
    ]
    for row, label, unit, formula, numfmt in kpis:
        a = ws.cell(row=row, column=1, value=label)
        a.font = font(10, bold=True)
        a.alignment = Alignment(vertical="center", indent=1)
        b = ws.cell(row=row, column=2, value=formula)
        b.font = font(12, bold=True, color=GREEN_FONT)
        b.number_format = numfmt
        b.alignment = Alignment(horizontal="right", vertical="center")
        c = ws.cell(row=row, column=3, value=unit)
        c.font = font(9, italic=True, color="FF595959")
        c.alignment = Alignment(horizontal="left", vertical="center", indent=1)
        for col in range(1, 4):
            ws.cell(row=row, column=col).border = Border(bottom=Side(style="thin", color=LIGHT))
        ws.row_dimensions[row].height = 20

    ws["B9"] = ('=IF(AND(US23!G3>0,US23!M3>=0,US23!U3>=0,US23!DZ3>=0,US23!DZ3<=1,'
                'ABS(US23!U3-US23!M3*2000/US23!G3)<0.01),"PASS","REVIEW")')
    ws["A9"] = "Source consistency status"
    ws["A9"].font = font(10, bold=True)
    ws["A9"].alignment = Alignment(vertical="center", indent=1)
    ws["B9"].font = font(12, bold=True, color=GREEN_FONT)
    ws["B9"].alignment = Alignment(horizontal="right", vertical="center")
    ws["C9"] = "PASS / REVIEW"
    ws["C9"].font = font(9, italic=True, color="FF595959")
    ws["C9"].alignment = Alignment(horizontal="left", vertical="center", indent=1)
    for col in range(1, 4):
        ws.cell(row=9, column=col).border = Border(bottom=Side(style="thin", color=LIGHT))
    ws.row_dimensions[9].height = 20

    # Scenario block
    section(ws, "A11:F11", "Scenario analysis — illustrative sensitivities, not forecasts")

    ws["A12"] = "Scenario selector"
    ws["A12"].font = font(10, bold=True)
    ws["A12"].alignment = Alignment(vertical="center", indent=1)
    ws["B12"] = "Base"
    ws["B12"].font = font(11, bold=True, color=BLUE_FONT)
    ws["B12"].fill = fill("FFFFF2CC")
    ws["B12"].alignment = Alignment(horizontal="center", vertical="center")
    ws["B12"].border = Border(left=Side(style="thin", color=MIDGRAY), right=Side(style="thin", color=MIDGRAY),
                              top=Side(style="thin", color=MIDGRAY), bottom=Side(style="thin", color=MIDGRAY))
    ws["C12"] = "Choose Base / Upside / Downside"
    ws["C12"].font = font(9, italic=True, color="FF595959")
    ws["C12"].alignment = Alignment(vertical="center", indent=1)

    headers = [("D12", "Scenario"), ("E12", "Emission intensity multiplier"), ("F12", "Generation multiplier")]
    for ref, text in headers:
        cell = ws[ref]
        cell.value = text
        cell.font = font(9, bold=True, color=WHITE)
        cell.fill = fill(NAVY)
        cell.alignment = Alignment(horizontal="center", vertical="center", wrap_text=True)
    ws.row_dimensions[12].height = 32

    scenarios = [("Base", 1.00, 1.00), ("Upside", 1.08, 1.05), ("Downside", 0.93, 0.95)]
    for i, (name, intensity, generation) in enumerate(scenarios):
        r = 13 + i
        d = ws.cell(row=r, column=4, value=name)
        d.font = font(10, bold=True, color=BLUE_FONT)
        d.alignment = Alignment(horizontal="center", vertical="center")
        d.fill = fill(PALE)
        for col, value in ((5, intensity), (6, generation)):
            cell = ws.cell(row=r, column=col, value=value)
            cell.font = font(10, color=BLUE_FONT)
            cell.number_format = '0.00"x"'
            cell.alignment = Alignment(horizontal="center", vertical="center")
        ws.row_dimensions[r].height = 19

    ws["A13"] = "Selected emission intensity multiplier"
    ws["A14"] = "Selected generation multiplier"
    ws["A15"] = "Projected annual net generation"
    ws["A16"] = "Projected annual CO2 emissions"
    for r in range(13, 17):
        ws.cell(row=r, column=1).font = font(10, bold=(r >= 15))
        ws.cell(row=r, column=1).alignment = Alignment(vertical="center", indent=1)
        ws.row_dimensions[r].height = 20

    ws["B13"] = "=INDEX($E$13:$E$15,MATCH($B$12,$D$13:$D$15,0))"
    ws["B14"] = "=INDEX($F$13:$F$15,MATCH($B$12,$D$13:$D$15,0))"
    ws["B15"] = "=B5*B14"
    ws["B16"] = "=B6*B13*B14"
    for r, numfmt in ((13, '0.00"x"'), (14, '0.00"x"'), (15, "#,##0"), (16, "#,##0")):
        cell = ws.cell(row=r, column=2)
        cell.font = font(11, bold=(r >= 15), color=BLACK_FONT)
        cell.number_format = numfmt
        cell.alignment = Alignment(horizontal="right", vertical="center")
        cell.border = Border(bottom=Side(style="thin", color=LIGHT))
    ws["C15"] = "MWh"
    ws["C16"] = "short tons"
    for r in (15, 16):
        c = ws.cell(row=r, column=3)
        c.font = font(9, italic=True, color="FF595959")
        c.alignment = Alignment(horizontal="left", vertical="center", indent=1)

    # Chart data tables
    section(ws, "A18:B18", "Annual net generation by state (MWh)")
    section(ws, "D18:E18", "U.S. generation resource mix (share)")
    ws["A19"] = "State"
    ws["B19"] = "Annual net generation (MWh)"
    ws["D19"] = "Resource"
    ws["E19"] = "Generation share"
    for ref in ("A19", "B19", "D19", "E19"):
        cell = ws[ref]
        cell.font = font(9, bold=True, color=NAVY)
        cell.fill = fill(GRAY)
        cell.alignment = Alignment(horizontal="center", vertical="center")
        cell.border = Border(bottom=Side(style="thin", color=MIDGRAY))
    ws.row_dimensions[19].height = 26

    states = [("CA", "=ST23!I7"), ("NY", "=ST23!I37"), ("TX", "=ST23!I47"),
              ("FL", "=ST23!I12"), ("PA", "=ST23!I41")]
    for i, (label, formula) in enumerate(states):
        r = 20 + i
        a = ws.cell(row=r, column=1, value=label)
        a.font = font(10, bold=True)
        a.alignment = Alignment(horizontal="center", vertical="center")
        b = ws.cell(row=r, column=2, value=formula)
        b.font = font(10, color=GREEN_FONT)
        b.number_format = "#,##0"
        b.alignment = Alignment(horizontal="right", vertical="center")

    resources = [("Coal", "=US23!DX3"), ("Gas", "=US23!DZ3"), ("Nuclear", "=US23!EA3"),
                 ("Hydro", "=US23!EB3"), ("Wind", "=US23!ED3"), ("Solar", "=US23!EE3")]
    for i, (label, formula) in enumerate(resources):
        r = 20 + i
        d = ws.cell(row=r, column=4, value=label)
        d.font = font(10, bold=True)
        d.alignment = Alignment(horizontal="center", vertical="center")
        e = ws.cell(row=r, column=5, value=formula)
        e.font = font(10, color=GREEN_FONT)
        e.number_format = "0.0%"
        e.alignment = Alignment(horizontal="right", vertical="center")

    ws.merge_cells("A27:F27")
    ws["A27"] = ("Notes: KPI values are published eGRID2023 U.S. totals pulled directly from US23; "
                 "they are not reaggregated from unit or plant rows. Scenario outputs are illustrative "
                 "sensitivities and should not be read as forecasts.")
    ws["A27"].font = font(8, italic=True, color="FF595959")
    ws["A27"].alignment = Alignment(horizontal="left", vertical="top", wrap_text=True)
    ws.row_dimensions[27].height = 30

    # Data validation for the scenario selector
    dv = DataValidation(type="list", formula1='"Base,Upside,Downside"', allow_blank=False,
                        showErrorMessage=True, errorTitle="Invalid scenario",
                        error="Select Base, Upside or Downside.")
    dv.promptTitle = "Scenario"
    dv.prompt = "Select Base, Upside or Downside."
    ws.add_data_validation(dv)
    dv.add(ws["B12"])

    # Conditional formatting on two distinct regions
    red_fill = fill("FFFFC7CE")
    red_font = Font(name=ARIAL, color="FF9C0006", bold=True)
    green_fill = fill("FFC6EFCE")
    green_font = Font(name=ARIAL, color="FF006100", bold=True)
    ws.conditional_formatting.add(
        "B5:B8", CellIsRule(operator="lessThan", formula=["0"], fill=red_fill, font=red_font))
    ws.conditional_formatting.add(
        "B9", FormulaRule(formula=['$B$9="PASS"'], fill=green_fill, font=green_font))
    ws.conditional_formatting.add(
        "B9", FormulaRule(formula=['$B$9="REVIEW"'], fill=red_fill, font=red_font))
    ws.conditional_formatting.add(
        "E20:E25", ColorScaleRule(start_type="min", start_color="FFFFFFFF",
                                  end_type="max", end_color="FF8EA9DB"))

    # Source / assumption comments
    ws["B5"].comment = Comment(
        "Source: US23!G3 — eGRID2023 Revision 2 U.S. annual net generation (MWh), published total. "
        "Linked directly; not reaggregated from unit rows.", "Analyst", width=320, height=110)
    ws["B9"].comment = Comment(
        "PASS only when US23!G3 > 0, US23!M3 and US23!U3 >= 0, US23!DZ3 is between 0 and 1, and "
        "ABS(U3 - M3*2000/G3) < 0.01 (lb per short ton conversion check).", "Analyst", width=320, height=110)
    ws["B12"].comment = Comment(
        "Editable scenario selector (data validation list). Drives B13:B16 through INDEX/MATCH lookups.",
        "Analyst", width=300, height=90)
    ws["E13"].comment = Comment(
        "Illustrative sensitivities authored for this summary: Base 1.00/1.00, Upside 1.08/1.05, "
        "Downside 0.93/0.95. Names denote higher/lower assumptions, not forecasts.", "Analyst",
        width=320, height=110)

    # Charts
    bar = BarChart()
    bar.type = "col"
    bar.style = 10
    bar.title = "Annual net generation by state (MWh)"
    bar.y_axis.title = "MWh"
    bar.x_axis.title = "State"
    bar.height = 8.6
    bar.width = 15.5
    data = Reference(ws, min_col=2, min_row=19, max_row=24)
    cats = Reference(ws, min_col=1, min_row=20, max_row=24)
    bar.add_data(data, titles_from_data=True)
    bar.set_categories(cats)
    bar.legend = None
    bar.series[0].graphicalProperties.solidFill = "2F5597"
    ws.add_chart(bar, "G4")

    pie = PieChart()
    pie.title = "U.S. generation resource mix (share)"
    pie.height = 8.6
    pie.width = 15.5
    pdata = Reference(ws, min_col=5, min_row=19, max_row=25)
    pcats = Reference(ws, min_col=4, min_row=20, max_row=25)
    pie.add_data(pdata, titles_from_data=True)
    pie.set_categories(pcats)
    pie.legend.position = "r"
    ws.add_chart(pie, "G24")

    # Arial everywhere on the new sheet
    for row in ws.iter_rows(min_row=1, max_row=28, min_col=1, max_col=6):
        for cell in row:
            if cell.font is None or cell.font.name != ARIAL:
                f = cell.font
                cell.font = Font(name=ARIAL, size=f.sz or 10, bold=bool(f.bold), italic=bool(f.italic),
                                 color=f.color)

    ws.print_area = "A1:F27"
    ws.sheet_properties.pageSetUpPr.fitToPage = True
    ws.page_setup.orientation = "landscape"
    wb.active = 0
    wb.save(DST)
    print("saved", DST, DST.stat().st_size)


if __name__ == "__main__":
    main()
