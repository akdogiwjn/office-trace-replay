#!/usr/bin/env python3
"""Generate per-record field_values JSON for the 2026 IRS W-4 batch.

Field IDs and page numbers are taken verbatim from output/form_field_info.json.
Only the 14 declared business fields are written; protected fields are never
emitted. Amounts are copied verbatim from input/synthetic_employees.json.
"""
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
INPUT = ROOT / "input"
OUTPUT = ROOT / "output"

TEXT_RULES = [
    ("topmostSubform[0].Page1[0].Step1a[0].f1_01[0]", "first_name", "first name"),
    ("topmostSubform[0].Page1[0].Step1a[0].f1_02[0]", "last_name", "last name"),
    ("topmostSubform[0].Page1[0].Step1a[0].f1_03[0]", "address", "street address"),
    ("topmostSubform[0].Page1[0].Step1a[0].f1_04[0]", "city_state_zip", "city, state, ZIP"),
    ("topmostSubform[0].Page1[0].Step3_ReadOrder[0].f1_06[0]", "children_credit",
     "credit for children under 17"),
    ("topmostSubform[0].Page1[0].Step3_ReadOrder[0].f1_07[0]", "other_dependents_credit",
     "credit for other dependents"),
    ("topmostSubform[0].Page1[0].f1_08[0]", "total_credit", "total dependent credits"),
    ("topmostSubform[0].Page1[0].f1_09[0]", "other_income", "other income"),
    ("topmostSubform[0].Page1[0].f1_10[0]", "deductions", "deductions"),
    ("topmostSubform[0].Page1[0].f1_11[0]", "extra_withholding", "extra withholding"),
]

CHECK_RULES = [
    ("topmostSubform[0].Page1[0].c1_1[0]", "filing_flags.single", "/1",
     "filing status single"),
    ("topmostSubform[0].Page1[0].c1_1[1]", "filing_flags.married", "/2",
     "filing status married filing jointly"),
    ("topmostSubform[0].Page1[0].c1_1[2]", "filing_flags.head_of_household", "/3",
     "filing status head of household"),
    ("topmostSubform[0].Page1[0].c1_2[0]", "multiple_jobs", "/1",
     "multiple jobs or spouse works checkbox"),
]


def resolve(record, dotted):
    value = record
    for key in dotted.split("."):
        value = value[key]
    return value


def main():
    field_info = json.loads((OUTPUT / "form_field_info.json").read_text())
    pages = {f["field_id"]: f["page"] for f in field_info}
    records = json.loads((INPUT / "synthetic_employees.json").read_text())["employees"]

    missing = [fid for fid, _, _ in TEXT_RULES if fid not in pages]
    missing += [fid for fid, _, _, _ in CHECK_RULES if fid not in pages]
    if missing:
        sys.exit(f"Field IDs absent from inspected schema: {missing}")

    out_dir = OUTPUT / "field_values"
    out_dir.mkdir(parents=True, exist_ok=True)
    written = []
    for record in records:
        items = []
        for fid, source, description in TEXT_RULES:
            items.append({
                "field_id": fid,
                "description": description,
                "page": pages[fid],
                "value": str(resolve(record, source)),
            })
        for fid, source, checked_value, description in CHECK_RULES:
            flag = resolve(record, source)
            items.append({
                "field_id": fid,
                "description": description,
                "page": pages[fid],
                "value": checked_value if flag else "/Off",
            })
        path = out_dir / f"{record['id']}.json"
        path.write_text(json.dumps(items, indent=2) + "\n")
        written.append((record["id"], len(items), sorted({i["page"] for i in items})))

    print(f"Wrote {len(written)} field-values files to {out_dir}")
    for ident, count, record_pages in written:
        print(f"  {ident}: {count} fields, page(s) {record_pages}")
    # Mapping audit: exactly one filing-status box selected per record.
    for record in records:
        flags = record["filing_flags"]
        selected = [k for k, v in flags.items() if v]
        if len(selected) != 1:
            sys.exit(f"{record['id']} has {len(selected)} filing flags: {selected}")
    print("Audit: every record selects exactly one filing-status checkbox.")


if __name__ == "__main__":
    main()
