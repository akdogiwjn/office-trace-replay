  "requirements": {
    "metrics": [
      {
        "id": "total_shipments",
        "name": "Total shipments",
        "meaning": "All manufacturing industries seasonally adjusted March 2025 shipments. Do not sum overlapping industry hierarchy rows.",
        "unit": "USD million"
      },
      {
        "id": "monthly_growth",
        "name": "Monthly change",
        "meaning": "Relative change in all-manufacturing adjusted shipments February to March 2025 computed from levels.",
        "unit": "fraction"
      },
      {
        "id": "durable_share",
        "name": "Durable goods share",
        "meaning": "Durable-goods March 2025 adjusted shipments as a fraction of all manufacturing shipments.",
        "unit": "fraction"
      },
      {
        "id": "nondurable_shipments",
        "name": "Nondurable shipments",
        "meaning": "Published nondurable-goods March 2025 seasonally adjusted shipments.",
        "unit": "USD million"
      }
    ],
    "scenario": {
      "default": "Base",
      "dimensions": [
        {
          "id": "shipments_multiplier",
          "meaning": "Hypothetical shipments multiplier, not an official forecast"
        }
      ],
      "rows": [
        {
          "name": "Base",
          "assumptions": {
            "shipments_multiplier": 1
          }
        },
        {
          "name": "Expansion",
          "assumptions": {
            "shipments_multiplier": 1.03
          }
        },
        {
          "name": "Contraction",
          "assumptions": {
            "shipments_multiplier": 0.97
          }
        }
      ],
      "projections": [
        {
          "id": "projected_shipments",
          "meaning": "Total adjusted shipments scaled by the selected multiplier",
          "unit": "USD million"
        }
      ]
    },
    "charts": [
      {
        "id": "durability_mix",
        "meaning": "Compare March 2025 seasonally adjusted durable versus nondurable shipments, excluding subordinate rows",
        "unit": "USD million"
      },
      {
        "id": "shipment_trend",
        "meaning": "All-manufacturing seasonally adjusted shipments January, February and March 2025 in chronological order",
        "unit": "USD million"
      }
    ],
