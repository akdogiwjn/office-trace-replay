          "tool_call": {
            "function_name": "exec",
            "arguments": {
              "command": "cd /root/.openclaw/workspace/tool-modeling/SUB-MEM-PDF-IRSW4-01 && python3 -c \"import json,pathlib; m=json.load(open('input/dataset_manifest.json')); ids={v['field_id'] for v in json.load(open('output/form_field_info.json'))}; rows=[json.load(open(p)) for p in pathlib.Path('output/field_values').glob('*.json')]; assert all(v['field_id'] in ids for r in rows for v in r); print('mapping checked')\""
            }
          }
        },
        {
          "adaptation": "document-oe-compatible-workflow-v1",
          "role": "write_helper",
          "tool_call": {
            "function_name": "write",
            "arguments": {
              "path": "/root/.openclaw/workspace/tool-modeling/SUB-MEM-PDF-IRSW4-01/run_batch_fill_render.py",
              "content": "\"\"\"The old fill/render subprocess pattern, with manifest paths and record IDs.\"\"\"\nimport json\nfrom pathlib import Path\nimport subprocess\n\nWS = Path.cwd()\nmanifest = json.loads((WS / 'input/dataset_manifest.json').read_text())\nrecords = json.loads((WS / 'input' / manifest['records']).read_text())[manifest['records_key']]\nskill = Path('/root/.openclaw/skills/pdf')\nfor record in records:\n    ident = record['id']\n    filled = WS / 'output/filled' / (ident + '.pdf')\n    rendered = WS / 'output/rendered' / ident\n    filled.parent.mkdir(parents=True, exist_ok=True)\n    rendered.mkdir(parents=True, exist_ok=True)\n    for command in (\n        ['python3', str(skill / 'scripts/fill_fillable_fields.py'),\n         str(WS / 'input' / manifest['form']), str(WS / 'output/field_values' / (ident + '.json')), str(filled)],\n        ['python3', str(skill / 'scripts/convert_pdf_to_images.py'), str(filled), str(rendered)],\n    ):\n        result = subprocess.run(command, capture_output=True, text=True, cwd=skill)\n        if result.returncode:\n            raise RuntimeError(f'{ident}: {command[1]}: {result.stderr}')\n    print('filled and rendered', ident)\n"
            }
          }
        }
